<?xml version="1.0"?>

<namelist_defaults>

<!-- Solar data from NRL -->
<solar_irrad_data_file>atm/cam/solar/SolarForcingCMIP7piControl_c20250103.nc</solar_irrad_data_file>
<solar_data_ymd>   20000101           </solar_data_ymd>
<solar_data_type>    FIXED            </solar_data_type>

<!-- LBC Files : -->
<flbc_file>      'atm/waccm/lb/LBC_2000climo_CMIP6_0p5degLat_c180227.nc' </flbc_file>
<flbc_cycle_yr>  2000                                </flbc_cycle_yr>
<flbc_type>      'CYCLICAL'                          </flbc_type>
<flbc_list>      'CO2','CH4','N2O','CFC11eq','CFC12' </flbc_list>

<!-- Low top upper boundary conditions -->
<ubc_specifier>'NOTSET'</ubc_specifier>
<ubc_file_path>'NONE'</ubc_file_path>

<!-- ozone data :  -->
<prescribed_ozone_datapath>   atm/cam/ozone                                                  </prescribed_ozone_datapath>
