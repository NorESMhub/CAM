<!--Options for megan -->
<megan_specifier>'isoprene = isoprene','monoterp = myrcene + sabinene + limonene+ carene_3 + ocimene_t_b + pinene_b + pinene_a'</megan_specifier>

<prescribed_volcaero_datapath>atm/cam/volc</prescribed_volcaero_datapath>
